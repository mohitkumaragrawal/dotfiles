# theme = Tomorrow
theme = Aura

cursor-style = block
cursor-style-blink = false
shell-integration-features = no-cursor

font-family = JetBrainsMono Nerd Font
keybind = ctrl+,=unbind

gtk-single-instance = true
quit-after-last-window-closed = false

font-feature = -calt
font-feature = -liga
font-feature = -dlig
